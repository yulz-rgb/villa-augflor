{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "memory": 256, "maxDuration": 15, "includeFiles": "data/calendar-busy.json" } },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.villa-augflor.com" }], "destination": "https://villa-augflor.com/:path*", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:lang(fr|de|nl)/index.html", "destination": "/:lang/", "permanent": true },
    { "source": "/about", "destination": "/rates.html", "permanent": true },
    { "source": "/about/", "destination": "/rates.html", "permanent": true },
    { "source": "/about/cancellation-policy", "destination": "/book-direct-safely.html", "permanent": true },
    { "source": "/about/cancellation-policy/", "destination": "/book-direct-safely.html", "permanent": true },
    { "source": "/terms-conditions", "destination": "/terms.html", "permanent": true },
    { "source": "/terms-conditions/", "destination": "/terms.html", "permanent": true },
    { "source": "/check-availability", "destination": "/rates.html#calendar", "permanent": true },
    { "source": "/check-availability/", "destination": "/rates.html#calendar", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/contact/", "destination": "/contact.html", "permanent": true },
    { "source": "/francais", "destination": "/fr/", "permanent": true },
    { "source": "/francais/", "destination": "/fr/", "permanent": true },
    { "source": "/villa.html", "destination": "/#about", "permanent": true },
    { "source": "/villa-details.html", "destination": "/#about", "permanent": true },
    { "source": "/guest-reviews.html", "destination": "/#reviews", "permanent": true },
    { "source": "/faq-booking.html", "destination": "/#faq", "permanent": true },
    { "source": "/booking-guide.html", "destination": "/book-direct-safely.html", "permanent": true },
    { "source": "/summer-family-vacation.html", "destination": "/", "permanent": true },
    { "source": "/girls-weekend-villa.html", "destination": "/", "permanent": true },
    { "source": "/family-villa.html", "destination": "/", "permanent": true },
    { "source": "/anniversary-getaway.html", "destination": "/", "permanent": true },
    { "source": "/adults-only-villa.html", "destination": "/", "permanent": true },
    { "source": "/eu-summer-2026-villa.html", "destination": "/", "permanent": true },
    { "source": "/corporate-retreats.html", "destination": "/", "permanent": true },
    { "source": "/book-villas-without-overpaying.html", "destination": "/rates.html", "permanent": true },
    { "source": "/solo-traveler-safety.html", "destination": "/#about", "permanent": true },
    { "source": "/off-season-bookings.html", "destination": "/rates.html", "permanent": true },
    { "source": "/french-riviera-guide.html", "destination": "/area.html", "permanent": true },
    { "source": "/riviera-vacation-tips.html", "destination": "/area.html", "permanent": true },
    { "source": "/villa-antibes-weekend.html", "destination": "/", "permanent": true },
    { "source": "/villa-near-cannes.html", "destination": "/villa-near-nice-airport.html", "permanent": true },
    { "source": "/villa-near-nice.html", "destination": "/villa-near-nice-airport.html", "permanent": true },
    { "source": "/fr/villa.html", "destination": "/#about", "permanent": true },
    { "source": "/riviera-area-guide.html", "destination": "/area.html", "permanent": true },
    { "source": "/best-beaches-cagnes.html", "destination": "/best-beaches-near-cagnes.html", "permanent": true },
    { "source": "/riviera-no-car.html", "destination": "/french-riviera-without-car.html", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests" }
    ] },
    { "source": "/assets/responsive/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/scripts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/styles/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
